PORT=5000
NODE_ENV=development
JWT_SECRET=climateshield-super-secret-jwt-key-2026-production-grade
CORS_ORIGIN=http://localhost:5173

# Database configuration
DATABASE_URL=
USE_LOCAL_DB=true

# External APIs (Optional - Open-Meteo works without keys; OpenWeather / NASA / Copernicus keys can be added here)
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
OPENWEATHER_API_KEY=
GEOCODING_API_KEY=
NASA_POWER_API_KEY=

# Demo Mode toggle
DEMO_MODE=false

# Monitoring Job interval (cron syntax or minutes)
MONITORING_INTERVAL_CRON=0 */6 * * *
MONITORING_AUTO_START=true
